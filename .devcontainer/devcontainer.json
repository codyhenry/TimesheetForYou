{
  "name": "TimesheetForYou Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22"
    }
  },

  "forwardPorts": [8000, 8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8000": {
      "label": "Django API",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Expo Metro",
      "onAutoForward": "notify"
    },
    "19000": {
      "label": "Expo",
      "onAutoForward": "silent"
    },
    "19001": {
      "label": "Expo",
      "onAutoForward": "silent"
    },
    "19002": {
      "label": "Expo DevTools",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "python --version && node --version && npm --version",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}