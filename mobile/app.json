{
  "expo": {
    "name": "TimesheetForYou",
    "slug": "timesheet-for-you",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "timesheetforyou",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timesheetforyou.app"
    },
    "android": {
      "package": "com.timesheetforyou.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
